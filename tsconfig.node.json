{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/main/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.mts",
    "vitest.config.mts"
  ]
}
